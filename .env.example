BIND_ADDR=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

TOOL_DATA_DIR=./data
APP_TEMP_DIR=/tmp/globustut-uploader
# DATABASE_PATH=./data/globustut.sqlite3
# UPLOAD_DIR=./data/pending
# THUMBNAIL_DIR=./data/thumbnails

MAX_FILE_MB=200
MAX_REQUEST_MB=2048
MAX_FILES=500
DISK_RESERVE_MB=512
MAX_PENDING_MB=20000
MAX_PIXELS=250000000
CONVERSION_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=3600
SESSION_TTL_HOURS=12

NEARBY_RADIUS_METERS=10000
NEARBY_CATEGORY_LIMIT=20
